# ========================================================
# FoundIt AI — 100% Google Stack Environment Configuration
# ========================================================
# Copy this file to .env and fill in your Google credentials:
# cp .env.example .env

# 1. Google Firebase (Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-google-cloud-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# 2. Google Gemini API (Google AI Studio: https://aistudio.google.com)
VITE_GEMINI_API_KEY=your-gemini-api-key
